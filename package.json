{
  "name": "warden",
  "version": "0.0.0-m1",
  "description": "Local firewall for AI coding agents — scans context files for invisible Unicode, prompt injection, suspicious MCP configs",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "verify": "bun run lint && bun run test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.3.0",
    "typescript": "5.7.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
